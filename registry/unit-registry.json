  "rules": [
    { "families": ["CALI", "BS"], "from_unit": "mm", "to_unit": "in", "factor_expression": "1.0 / 25.4", "offset_expression": "0.0", "derivation": "1 in = 25.4 mm exactly; mm -> in divides by 25.4", "automatic": true },
    { "families": ["CALI", "BS"], "from_unit": "cm", "to_unit": "in", "factor_expression": "1.0 / 2.54", "offset_expression": "0.0", "derivation": "1 in = 2.54 cm exactly; cm -> in divides by 2.54", "automatic": true },
    { "families": ["DT", "DTS"], "from_unit": "us/m", "to_unit": "us/ft", "factor_expression": "0.3048", "offset_expression": "0.0", "derivation": "1 international ft = 0.3048 m; (us/m) x (m/ft) = us/ft", "automatic": true },
    { "families": ["DT", "DTS"], "from_unit": "usec/m", "to_unit": "us/ft", "factor_expression": "0.3048", "offset_expression": "0.0", "derivation": "1 usec = 1 us and 1 international ft = 0.3048 m; factor = 0.3048", "automatic": true },
    { "families": ["RHOB", "DRHO"], "from_unit": "kg/m3", "to_unit": "g/cc", "factor_expression": "0.001", "offset_expression": "0.0", "derivation": "1 g/cc = 1000 kg/m3; kg/m3 -> g/cc divides by 1000", "automatic": true },
    { "families": ["NPHI", "POR"], "from_unit": "pu", "to_unit": "v/v", "factor_expression": "0.01", "offset_expression": "0.0", "derivation": "1 porosity unit = 1 percent = 0.01 v/v; porosity families only, because a porosity unit does not label a shale or clay volume", "automatic": true },
    { "families": ["NPHI", "POR", "VSH", "VSH_UNCLIPPED", "VCL"], "from_unit": "%", "to_unit": "v/v", "factor_expression": "0.01", "offset_expression": "0.0", "derivation": "1 percent = 1/100 = 0.01 v/v, the same arithmetic for every fraction family: neutron porosity, porosity, shale volume and clay volume", "automatic": true },
    { "families": ["NPHI", "POR"], "from_unit": "p.u.", "to_unit": "v/v", "factor_expression": "0.01", "offset_expression": "0.0", "derivation": "p.u. denotes porosity percent; 1 percent = 0.01 v/v; porosity families only, for the same reason as pu", "automatic": true },
    { "families": ["TEMP"], "from_unit": "DEGF", "to_unit": "DEGC", "factor_expression": "1.0 / 1.8", "offset_expression": "-32.0", "derivation": "T42 fixes degC = (degF - 32) / 1.8; factor = 1/1.8 and offset = -32 degF", "automatic": true },
    { "families": ["QV"], "from_unit": "MEQ/L", "to_unit": "meq/mL", "factor_expression": "1.0e-3", "offset_expression": "0.0", "derivation": "1 L = 10^3 mL; meq/L -> meq/mL therefore multiplies by 10^-3", "automatic": false }
  ]
